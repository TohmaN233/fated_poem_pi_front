# 复制为 .env 仅作记录；start-web.sh 不会自动 source .env。
# 推荐直接在命令前设置环境变量：
#   DEST_POET_GAME_DIR=/path/to/fated-poem-dusk-song ./start-web.sh

# 游戏包目录。留空时 start-web.sh 会尝试相邻目录：
# ../fated-poem-dusk-song、../fated_poem_dusk_song、../package
DEST_POET_GAME_DIR=

# Web UI 端口，默认 8787
DEST_POET_WEB_PORT=8787

# 绑定地址。留空通常最兼容 localhost 的 IPv4/IPv6。
# DEST_POET_WEB_HOST=127.0.0.1

# 开发模式：保留 pi-subagents 内置 coding agents。
# DEST_POET_DEV=1

# 外部 RPG 记忆服务路径；游戏包找不到 mempalace-rpg-mcp 时再设置。
# MEMPALACE_RPG_MCP=/absolute/path/mempalace-rpg-mcp

# 如不想启用 palace 原文归档，可设置为 off。
# MEMPALACE_RPG_PALACE=off
